# ---- Supabase (required) ----
# Create a project at https://supabase.com, then copy values from
# Project Settings -> API. Run supabase/schema.sql in the SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- PayPal (required for premium) ----
# "sandbox" for testing, "live" for real payments.
PAYPAL_ENV=sandbox
# Use credentials from a LIVE app under a verified Business account when PAYPAL_ENV=live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---- LLM ----
# Leave LLM_API_KEY empty to run in placeholder mode: the app works end-to-end
# but AI chat/replies/insights return friendly canned responses.
# The provider is any OpenAI-compatible /chat/completions endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
